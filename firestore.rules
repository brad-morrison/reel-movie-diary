rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read/write only their own diary document.
    match /diaries/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Handles are globally readable for availability checks, but a signed-in
    // user can only claim or release a handle that points to their own uid.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // A curated projection for shareable /@username pages. The private diary
    // document remains owner-only above.
    match /publicProfiles/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Public social graph. A user can create and remove only relationships
    // where they are the follower; nobody can follow on another user's behalf.
    match /follows/{followId} {
      allow read: if resource.data.status == 'accepted'
        || (request.auth != null && (resource.data.followerUid == request.auth.uid || resource.data.followedUid == request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['followerUid', 'followedUid', 'status', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followedUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && followId == request.auth.uid + '_' + request.resource.data.followedUid;
      allow update: if request.auth != null
        && resource.data.followedUid == request.auth.uid
        && (resource.data.status == 'pending' || !resource.data.keys().hasAny(['status']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted';
      allow delete: if request.auth != null
        && (resource.data.followerUid == request.auth.uid || resource.data.followedUid == request.auth.uid);
    }

    // Sanitized diary projection available only to the owner and followers
    // whose request the owner explicitly accepted.
    match /sharedDiaries/{ownerUid} {
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.data.ownerUid == ownerUid;
      allow read: if request.auth != null && (
        request.auth.uid == ownerUid
        || get(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + ownerUid)).data.status == 'accepted'
      );
    }
  }
}
